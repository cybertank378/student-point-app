generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

////////////////////////////////////////////////////
//////////////////// ENUMS /////////////////////////
////////////////////////////////////////////////////

enum AttendanceStatus {
  ALPHA
  SAKIT
  IZIN
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum TeacherRole {
  SUBJECT_TEACHER
  HOMEROOM
  COUNSELOR
  DUTY_TEACHER
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  DROPPED
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
}

enum ParentType {
  FATHER
  MOTHER
  GUARDIAN
}

enum ViolationLevel {
  LIGHT
  MEDIUM
  HEAVY
}

enum ViolationResolutionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

enum ViolationActionType {
  WARNING
  WRITTEN_NOTICE
  COUNSELING
  PARENT_CALL
  SUSPENSION
}

enum EducationLevel {
  SD
  SMP
  SMA
  DI
  DII
  DIII
  DIV
  S1
  S2
  S3
}

enum CivilServantRank {
  I_A
  I_B
  I_C
  I_D
  II_A
  II_B
  II_C
  II_D
  III_A
  III_B
  III_C
  III_D
  IV_A
  IV_B
  IV_C
  IV_D
  IV_E
}

enum FamilyStatus {
  COMPLETE
  SINGLE_MOTHER
  SINGLE_FATHER
  ORPHAN
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ESCALATED
}

enum CaseSource {
  VIOLATION_POINT
  TEACHER_REPORT
  SELF_REPORT
  PARENT_REPORT
}

enum DisciplineActionType {
  WARNING_1
  WARNING_2
  CALL_BK
  CALL_PARENT
  DISCIPLINE_HEARING
}

enum HouseOwnership {
  OWNED
  RENT
  FAMILY
  GOVERNMENT
  OTHER
}

////////////////////////////////////////////////////
//////////////////// MASTER ////////////////////////
////////////////////////////////////////////////////

model Religion {
  id        String    @id @default(uuid())
  kode      String    @unique
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  parents  Parent[]
  students Student[]
  teachers Teacher[]

  @@index([name])
  @@index([deletedAt])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes            Class[]
  enrollments        StudentEnrollment[]
  violations         StudentViolation[]
  point              StudentPoint[]
  disciplinePolicies DisciplineThreshold[]
  counselingCases    CounselingCase[]
  aids               StudentAid[]
  achievements       StudentAchievement[]

  @@index([isActive])
}

model Class {
  id    String @id @default(uuid())
  grade String
  name  String

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  homeroomTeacherId String?
  homeroomTeacher   Teacher? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  enrollments StudentEnrollment[]

  createdAt DateTime @default(now())

  @@unique([grade, name, academicYearId])
  @@unique([homeroomTeacherId, academicYearId])
  @@index([academicYearId])
  @@index([grade])
  @@index([grade, academicYearId])
}

////////////////////////////////////////////////////
//////////////////// AUTH //////////////////////////
////////////////////////////////////////////////////

model User {
  id                 String       @id @default(uuid())
  username           String       @unique
  password           String
  image              String?
  role               Role
  teacherRole        TeacherRole?
  refreshToken       String?
  isActive           Boolean      @default(true)
  version            Int          @default(1)
  failedAttempts     Int          @default(0)
  lockUntil          DateTime?
  mustChangePassword Boolean      @default(true)

  studentId String? @unique
  parentId  String? @unique
  teacherId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    AuthSession[]
  loginAudits LoginAudit[]
  resetTokens PasswordResetToken[]

  parent  Parent?  @relation(fields: [parentId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@index([lockUntil])
  @@index([failedAttempts])
  @@index([createdAt])
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  device    String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
  @@index([userId, revoked, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([used])
}

model LoginAudit {
  id         String   @id @default(uuid())
  userId     String?
  identifier String
  success    Boolean
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([identifier])
  @@index([createdAt])
  @@index([success])
}

////////////////////////////////////////////////////
//////////////////// STUDENT ///////////////////////
////////////////////////////////////////////////////

model Student {
  id           String   @id @default(uuid())
  nis          String?  @unique
  nisn         String   @unique
  name         String
  nickname     String?
  gender       Gender
  photo        String?
  birthPlace   String
  birthDate    DateTime
  address      String
  phone        String?
  email        String?
  religionCode String

  nik             String?
  kkNumber        String?
  schoolOrigin    String?
  graduationScore Float?
  instagram       String?

  familyStatus FamilyStatus @default(COMPLETE)
  isDifable    Boolean      @default(false)
  difableNotes String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  religion Religion @relation(fields: [religionCode], references: [kode])

  achievements    StudentAchievement[]
  parents         StudentParent[]
  violations      StudentViolation[]
  enrollments     StudentEnrollment[]
  attendances     StudentAttendance[]
  counselingCases CounselingCase[]
  point           StudentPoint[]
  aids            StudentAid[]

  user                    User?
  studentProfile          StudentProfile?
  studentFacility         StudentFacility?
  studentReligionActivity StudentReligionActivity?
  studentHealthAbility    StudentHealthAbility?
  studentFamilyInfo       StudentFamilyInfo? // 🔥 ditambahkan

  @@index([name])
  @@index([nis])
  @@index([nisn])
  @@index([religionCode])
  @@index([gender])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deletedAt, isDifable])
  @@index([familyStatus])
  @@index([religionCode, gender])
  // 🔥 tambahan untuk query filter dashboard
  @@index([deletedAt, gender])
  @@index([deletedAt, religionCode])
}

model StudentEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  classId        String
  status         EnrollmentStatus
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  updatedAt      DateTime?        @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([academicYearId, classId])
  @@index([studentId, academicYearId])
  @@index([academicYearId, status])
  @@index([classId, academicYearId])
  @@index([deletedAt])
  // 🔥 tambahan untuk query siswa aktif per kelas
  @@index([classId, status])
  @@index([status])
}

model StudentProfile {
  id        String @id @default(uuid())
  studentId String @unique

  childOrder    Int?
  totalSiblings Int?

  distanceToSchool String?
  transport        String?

  hobby       String?
  dream       String?
  closeFriend String?

  student Student @relation(fields: [studentId], references: [id])
}

model StudentFacility {
  id        String @id @default(uuid())
  studentId String @unique

  hasPC     Boolean
  hasLaptop Boolean
  hasPhone  Boolean

  internetAccess String

  student Student @relation(fields: [studentId], references: [id])
}

model StudentReligionActivity {
  id        String @id @default(uuid())
  studentId String @unique

  prayFiveTimes   Boolean?
  oftenMissPrayer String?
  quranStudyLevel String?

  worshipActivities String?
  worshipLocation   String?

  student Student @relation(fields: [studentId], references: [id])
}

model StudentHealthAbility {
  id        String @id @default(uuid())
  studentId String @unique

  inclusion Boolean

  canRead  Boolean
  canWrite Boolean
  canCount Boolean
  canSpeak Boolean

  canFollowCeremony Boolean
  canDoSport        Boolean
  canSeeBoard       Boolean
  canHearClearly    Boolean
  canWalkRun        Boolean
  canHoldPen        Boolean

  dominantHandRight Boolean

  diseaseHistory String?

  hasPsychologistLetter Boolean? // 🔥 surat psikolog
  hasIQTest             Boolean? // 🔥 sudah tes IQ
  iqScore               Int? // 🔥 skor IQ

  student Student @relation(fields: [studentId], references: [id])
}

model StudentFamilyInfo {
  id        String @id @default(uuid())
  studentId String @unique

  livingWith String

  houseOwnership HouseOwnership?

  headOfFamilyName  String
  familyCardAddress String
  documents         String[]

  student Student @relation(fields: [studentId], references: [id])
}

model StudentAid {
  id String @id @default(uuid())

  studentId      String
  academicYearId String

  kjp Boolean @default(false)
  pip Boolean @default(false)

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
}

model Achievement {
  id        String    @id @default(uuid())
  name      String    @unique
  point     Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  records StudentAchievement[]

  @@unique([name, deletedAt])
  @@index([deletedAt])
}

model StudentAchievement {
  id             String   @id @default(uuid())
  studentId      String
  achievementId  String
  academicYearId String
  point          Int
  achievedAt     DateTime
  createdAt      DateTime @default(now())

  achievement  Achievement  @relation(fields: [achievementId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([achievementId])
  @@index([academicYearId])
  @@index([achievedAt])
  @@index([studentId, achievedAt])
}

model StudentAttendance {
  id        String           @id @default(uuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
  @@index([studentId, date])
  @@index([date, status])
  @@index([status])
}

////////////////////////////////////////////////////
//////////////////// PARENT ////////////////////////
////////////////////////////////////////////////////

model Parent {
  id String @id @default(uuid())

  name  String
  email String?

  education EducationLevel
  job       String
  income    String?

  religionCode String
  phone        String @unique
  address      String

  guardianRelation String? // 🔥 hubungan wali (tante, paman, dll)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  religion Religion @relation(fields: [religionCode], references: [kode])

  students StudentParent[]

  user User?

  @@index([religionCode])
  @@index([name])
}

model StudentParent {
  id        String     @id @default(uuid())
  studentId String
  parentId  String
  role      ParentType
  createdAt DateTime   @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, role])
  // 🔥 tambahan untuk query parent → siswa
  @@index([parentId])
}

////////////////////////////////////////////////////
//////////////////// TEACHER ///////////////////////
////////////////////////////////////////////////////

model Teacher {
  id String @id @default(uuid())

  nip   String? @unique @db.VarChar(18)
  nuptk String? @unique @db.VarChar(16)
  nrk   String? @unique @db.VarChar(12)
  nrg   String  @unique @db.VarChar(12)

  name   String
  gender Gender
  photo  String?

  religionCode String
  religion     Religion @relation(fields: [religionCode], references: [kode])

  phone String?
  email String?

  educationLevel EducationLevel
  major          String?
  graduationYear Int

  birthPlace String
  birthDate  DateTime

  civilServantRank CivilServantRank?
  roles            TeacherRole[]
  isPns            Boolean

  homeroomOf Class[] @relation("HomeroomTeacher")
  user       User?

  handledResolutions ViolationResolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
//////////////////// DISCIPLINE ////////////////////
////////////////////////////////////////////////////

model Violation {
  id        String         @id @default(uuid())
  name      String         @unique
  point     Int
  level     ViolationLevel
  deletedAt DateTime?
  createdAt DateTime       @default(now())

  records StudentViolation[]
}

model StudentViolation {
  id             String   @id @default(uuid())
  studentId      String
  violationId    String
  academicYearId String
  point          Int
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  student      Student      @relation(fields: [studentId], references: [id])
  violation    Violation    @relation(fields: [violationId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  resolution ViolationResolution?

  @@index([studentId])
  @@index([violationId])
  @@index([academicYearId])
  @@index([occurredAt])
  @@index([studentId, academicYearId])
  @@index([academicYearId, occurredAt])
  @@index([studentId, occurredAt])
}

model ViolationResolution {
  id                 String                    @id @default(uuid())
  studentViolationId String                    @unique
  handlerTeacherId   String
  status             ViolationResolutionStatus
  action             ViolationActionType
  note               String?
  resolvedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  logs             ViolationActionLog[]
  handlerTeacher   Teacher              @relation(fields: [handlerTeacherId], references: [id])
  studentViolation StudentViolation     @relation(fields: [studentViolationId], references: [id])
}

model ViolationActionLog {
  id           String              @id @default(uuid())
  resolutionId String
  action       ViolationActionType
  note         String?
  createdAt    DateTime            @default(now())

  resolution ViolationResolution @relation(fields: [resolutionId], references: [id])

  @@unique([resolutionId, action])
}

model DisciplineThreshold {
  id             String               @id @default(uuid())
  academicYearId String
  minPoint       Int
  actionType     DisciplineActionType
  createdAt      DateTime             @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([academicYearId])
  @@index([academicYearId, minPoint])
}

////////////////////////////////////////////////////
//////////////////// COUNSELING ////////////////////
////////////////////////////////////////////////////

model CounselingCase {
  id             String     @id @default(uuid())
  studentId      String
  academicYearId String
  reason         String
  source         CaseSource
  status         CaseStatus
  openedAt       DateTime   @default(now())
  closedAt       DateTime?

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([academicYearId])
  @@index([openedAt])
  @@index([studentId])
  @@index([status])
  @@index([studentId, status])
  @@index([academicYearId, status])
}

////////////////////////////////////////////////////
//////////////////// POINT SUMMARY /////////////////
////////////////////////////////////////////////////

model StudentPoint {
  id String @id @default(uuid())

  studentId      String
  academicYearId String

  totalViolationPoint   Int @default(0)
  totalAchievementPoint Int @default(0)
  totalPoint            Int @default(0)

  updatedAt DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId]) // 🔥 tambahkan ini
  @@index([studentId])
  @@index([academicYearId])
  @@index([totalPoint])
  @@index([academicYearId, totalPoint])
}

////////////////////////////////////////////////////
//////////////////// AUDIT /////////////////////////
////////////////////////////////////////////////////

model SystemAuditLog {
  id String @id @default(uuid())

  actorId   String?
  actorRole Role?

  entity   String
  entityId String

  action String
  before Json?
  after  Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
}
